{
  "_version": "1.60.0",
  "sap.app": {
    "id": "fluidra.qm.managehu.managehandlinguints",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.28.0",
      "toolsId": "94bd665b-258d-4b43-bdd9-9aac23a02785"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zui_managehandlingunits_o4/srvd/sap/zui_managehandlingunits/0001/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.46",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "fluidra.qm.managehu.managehandlinguints.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ManageHandlingUnitsList",
          "target": "ManageHandlingUnitsList"
        },
        {
          "pattern": "ManageHandlingUnits({key}):?query:",
          "name": "ManageHandlingUnitsObjectPage",
          "target": "ManageHandlingUnitsObjectPage"
        }
      ],
      "targets": {
        "ManageHandlingUnitsList": {
          "type": "Component",
          "id": "ManageHandlingUnitsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ManageHandlingUnits",
              "variantManagement": "Page",
              "navigation": {
                "ManageHandlingUnits": {
                  "detail": {
                    "route": "ManageHandlingUnitsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable",
                    "defaultPopinLayout": "GridSmall",
                    "demandPopin": true,
                    "popinDisplay": "Block"
                  },
                  "actions": {
                    "Rec": {
                      "press": "fluidra.qm.managehu.managehandlinguints.ext.controller.ExtendingList.OnRec",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": true,
                      "text": "Rec."
                    }
                  }
                }
              }
            }
          }
        },
        "ManageHandlingUnitsObjectPage": {
          "type": "Component",
          "id": "ManageHandlingUnitsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/ManageHandlingUnits"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
