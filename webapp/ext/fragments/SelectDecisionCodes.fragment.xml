<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:comp="sap.ui.comp.valuehelpdialog" xmlns:mdc="sap.ui.mdc" xmlns:mdcTable="sap.ui.mdc.table">
    <Dialog id="stDialog" title="Select Records" stretch="false" contentWidth="90%" contentHeight="60%" afterClose="onafterClose" afterOpen="afterDialogOpen">
        <endButton>
            <Button text="{i18n>closeButton}" press=".onDailogClose" icon="sap-icon://decline"/>
        </endButton>
        <beginButton>
            <Button text="{i18n>recordGlobalUsg}" press=".onRecordUD" type="Emphasized" id="postbtn" enabled="false" icon="sap-icon://save"/>
        </beginButton>
        <content>
            <OverflowToolbar>
                <SearchField id="sfUsageSearch" width="25rem" placeholder="Search..." liveChange=".onSearch"/>

                <ToolbarSpacer/>

                
            </OverflowToolbar>
            <Table noDataText="Drop column list items here and columns in the area above" id="table0" selectionChange="onItemSelect" fixedLayout="false" growing="true" mode="SingleSelectLeft" popinLayout="GridLarge" width="" alternateRowColors="true" sticky="ColumnHeaders">
                <items>
                    <ColumnListItem type="Active">
                        <cells>
                            <Text text="{UsageDecisionCode}"/>
                            <Text text="{UsageDecisionCodeText}"/>
                            <Text text="{UsageDecisionCodeGroup}"/>
                            <Text text="{SelectedCodeSet}"/>
                            <Text text="{SelectedCodeSetText}"/>
                            <Text text="{SelectedCodeSetPlant}"/>
                            <!-- <Text text="{InspectionLot}"/> -->
                        </cells>
                    </ColumnListItem>
                </items>
                <columns>
                    <Column id="column0">
                        <header>
                            <Label id="label0" text="Usage Decision Code"/>
                        </header>
                    </Column>
                    <Column id="column1">
                        <header>
                            <Label text="Usage Decision Code Text" id="label1"/>
                        </header>
                    </Column>
                    <Column id="column2">
                        <header>
                            <Label text="Usage Decision Code Grp" id="label2"/>
                        </header>
                    </Column>
                    <Column id="column3">
                        <header>
                            <Label id="label3" text="Selected Code Set"/>
                        </header>
                    </Column>
                    <Column id="column4">
                        <header>
                            <Label text="Selected Code Set Text" id="label4"/>
                        </header>
                    </Column>
                    <Column id="column5">
                        <header>
                            <Label text="Selected Code Set Plant" id="label5"/>
                        </header>
                    </Column>
                    <!-- <Column id="column6">
                        <header>
                            <Label text="Inspection Lot" id="label6"/>
                        </header>
                    </Column> -->
                </columns>
            </Table>
        </content>
    </Dialog>
</core:FragmentDefinition>